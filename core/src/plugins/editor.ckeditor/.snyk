# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.1
ignore: {}
# patches apply the minimum changes required to fix a vulnerability
patch:
  'npm:lodash:20180130':
    - grunt-browserify > lodash:
        patched: '2024-12-19T22:06:40.433Z'
        id: 'npm:lodash:20180130'
        path: grunt-browserify > lodash
  'npm:minimatch:20160620':
    - grunt-browserify > browserify > glob > minimatch:
        patched: '2024-12-19T22:06:40.433Z'
        id: 'npm:minimatch:20160620'
        path: grunt-browserify > browserify > glob > minimatch
